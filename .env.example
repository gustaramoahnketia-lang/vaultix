# Copy this file to `.env` and fill in real values before deploying.
# Never commit the real `.env` file to Git.

# Port the HTTP server listens on.
PORT=4173

# Where the SQLite database file lives. Change this to a persistent volume
# path in production (e.g. a mounted disk), not a path inside the container
# image itself.
VAULTIX_DATA_DIR=./data
VAULTIX_DB_PATH=./data/vaultix.db

# Server-side "pepper" appended to every password/PIN before hashing and to
# every key derivation. Generate a long random value and store it ONLY in
# your secrets manager / environment — never in the database, never in Git.
# Example generator: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
VAULTIX_KEY_PEPPER=replace-with-a-long-random-value-and-never-commit-it

# In a networked deployment, recovery codes and account notifications should
# go through a real email provider instead of the server console. Fill these
# in when you wire that up (see README "What changes with network access").
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Set to "production" to enable stricter defaults (e.g. refuse to boot
# without VAULTIX_KEY_PEPPER set). Not enforced yet in this reference build
# — see README "Production hardening checklist".
NODE_ENV=development
